# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: Optional global telemetry backend.
# Create a free Supabase project and a `game_runs` table (see README) to enable
# real global run counts and percentile ranks. Without these, the game falls
# back to a local per-browser simulation so it still works out of the box.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
